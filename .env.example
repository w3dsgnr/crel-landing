# Cloudflare Turnstile — капча форм контакта и подписки (lib/useTurnstile.ts).
# Sitekey публичный, инлайнится в бандл при next build. Пусто → тестовый ключ
# Cloudflare 1x00000000000000000000AA (всегда проходит), только для разработки.
# Секретный ключ (siteverify) сюда НЕ класть — он живёт на эндпоинте формы.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
